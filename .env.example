# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# Postgres — matches docker-compose.yml's `postgres` service by default.
# Two separate roles, on purpose (see docker/postgres/init/01-create-app-role.sh):
#   - POSTGRES_USER / POSTGRES_PASSWORD: initdb bootstrap role. Always a
#     superuser in the official postgres image, so it ALWAYS bypasses Row-
#     Level Security. Used only for running migrations (DATABASE_MIGRATION_URL).
#   - amarshop_app / POSTGRES_APP_PASSWORD: ordinary login role the app
#     actually connects as at runtime (DATABASE_URL). RLS policies apply to
#     it unconditionally — this is the connection tenant isolation depends on.
POSTGRES_DB=amarshop
POSTGRES_USER=amarshop
POSTGRES_PASSWORD=changeme
POSTGRES_APP_PASSWORD=changeme-app

DATABASE_URL=postgresql://amarshop_app:changeme-app@localhost:5432/amarshop
DATABASE_MIGRATION_URL=postgresql://amarshop:changeme@localhost:5432/amarshop

# Redis — matches docker-compose.yml's `redis` service by default.
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost

# Platform host — requests to this host (and its subdomains) skip storefront
# tenant resolution in proxy.ts (admin/marketing surfaces). Must match the
# Host header browsers actually send: no port for the default HTTP port 80
# (what you get going through docker-compose's Caddy on http://localhost),
# but DOES need a port again if running via `pnpm dev` directly on the host
# (e.g. localhost:3000), since browsers include non-default ports in Host.
PLATFORM_ROOT_DOMAIN=localhost

# Merchant custom domains (admin -> Custom Domain). Verification checks the
# domain's DNS points at us:
#   PLATFORM_PUBLIC_IP  - comma-separated A-record target(s) for the VPS,
#                         so apex domains pointed via an A record verify.
#                         Optional; CNAME-to-{slug}.PLATFORM_ROOT_DOMAIN
#                         works without it.
#   CUSTOM_DOMAIN_VERIFY_MODE - "dns" (default) does the real lookup;
#                         "trust" skips it and marks any domain verified
#                         (local dev only — there's no real DNS for a test
#                         domain), logging a warning each time.
PLATFORM_PUBLIC_IP=
CUSTOM_DOMAIN_VERIFY_MODE=dns

# Set to "true" ONLY on a dev/staging box. Stores flagged is_demo (the
# `pnpm db:seed` fixtures) are hidden from host resolution unless this is
# set, so a seeded "Demo Store" can never be served or indexed in
# production. Leave empty everywhere real merchants exist.
ALLOW_DEMO_STORES=true

# Local-disk storage adapter (see src/lib/storage) — absolute path on the
# VPS/container, mounted as its own Docker volume so it survives redeploys.
UPLOADS_DIR=./uploads

# SSLCommerz is configured per-store from the admin panel (Payment
# Settings) — each merchant brings their own SSLCommerz account. No
# platform-level credentials; nothing to set here.

# Symmetric key for encrypting stored third-party credentials (courier API
# keys, SSLCommerz store passwords, etc.) — `openssl rand -base64 32`. If
# unset, those values are stored unencrypted with a warning; set this
# before production.
APP_SECRET_KEY=

# AI copywriter (admin -> product form -> "Generate with AI"). Platform-
# level, provider-agnostic (src/lib/ai). Leave AI_PROVIDER unset to use the
# offline stub that returns placeholder text — the feature still works, it
# just doesn't call out.
#   AI_PROVIDER  - "openai" (any OpenAI-compatible /v1/chat/completions
#                  endpoint) | "anthropic" (Messages API) | unset -> stub
#   AI_API_KEY   - the provider key
#   AI_BASE_URL  - openai provider only; blank = https://api.openai.com/v1,
#                  OpenRouter = https://openrouter.ai/api/v1, etc.
#   AI_MODEL     - e.g. gpt-4o-mini, openai/gpt-4o-mini (OpenRouter),
#                  claude-haiku-4-5-20251001
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# BDCourier COD fraud check (admin -> order detail). One platform-level
# token serves every store; the check runs automatically on each new COD
# order. Leave BDCOURIER_API_KEY unset to use the offline stub (canned
# risk levels, no network).
#   BDCOURIER_API_KEY  - from your bdcourier.com account -> Settings
#   BDCOURIER_BASE_URL - blank = https://api.bdcourier.com
BDCOURIER_API_KEY=
BDCOURIER_BASE_URL=

# Platform subscription billing (merchant -> AmarShop, admin -> Billing &
# Plan). The platform's OWN bKash / Nagad "Send Money" numbers that
# merchants pay their plan to — shown to merchants, so config not secrets.
# A merchant picks a plan, sends money here, submits the TrxID, and a
# platform admin verifies it at /platform/billing. Leave blank and the
# Billing page tells merchants to contact support.
PLATFORM_BKASH_NUMBER=
PLATFORM_NAGAD_NUMBER=
PLATFORM_BILLING_INSTRUCTIONS=
