# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# Postgres — matches docker-compose.yml's `postgres` service by default.
# Two separate roles, on purpose (see docker/postgres/init/01-create-app-role.sh):
#   - POSTGRES_USER / POSTGRES_PASSWORD: initdb bootstrap role. Always a
#     superuser in the official postgres image, so it ALWAYS bypasses Row-
#     Level Security. Used only for running migrations (DATABASE_MIGRATION_URL).
#   - amarshop_app / POSTGRES_APP_PASSWORD: ordinary login role the app
#     actually connects as at runtime (DATABASE_URL). RLS policies apply to
#     it unconditionally — this is the connection tenant isolation depends on.
POSTGRES_DB=amarshop
POSTGRES_USER=amarshop
POSTGRES_PASSWORD=changeme
POSTGRES_APP_PASSWORD=changeme-app

DATABASE_URL=postgresql://amarshop_app:changeme-app@localhost:5432/amarshop
DATABASE_MIGRATION_URL=postgresql://amarshop:changeme@localhost:5432/amarshop

# Redis — matches docker-compose.yml's `redis` service by default.
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost

# Platform host — requests to this host (and its subdomains) skip storefront
# tenant resolution in proxy.ts (admin/marketing surfaces). Must match the
# Host header browsers actually send: no port for the default HTTP port 80
# (what you get going through docker-compose's Caddy on http://localhost),
# but DOES need a port again if running via `pnpm dev` directly on the host
# (e.g. localhost:3000), since browsers include non-default ports in Host.
PLATFORM_ROOT_DOMAIN=localhost

# Local-disk storage adapter (see src/lib/storage) — absolute path on the
# VPS/container, mounted as its own Docker volume so it survives redeploys.
UPLOADS_DIR=./uploads

# SSLCommerz (Phase 1 — not wired up yet, placeholders for when it is)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=true
