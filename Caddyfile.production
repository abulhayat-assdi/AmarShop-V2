# Production Caddyfile — NOT used in local dev (docker-compose.yml mounts
# ./Caddyfile, the plain-HTTP one). Point docker-compose's caddy service at
# this file on the VPS once real DNS is in place and PLATFORM_ROOT_DOMAIN
# is a real domain. Tracked in CLAUDE.md's "Deferred — needs a real VPS".

{
	# Caddy calls this before issuing a cert for any hostname it hasn't
	# seen. It returns 200 only for a host that resolves to a store — a
	# slug subdomain or a merchant's DNS-verified custom domain
	# (src/app/api/internal/domain-check -> resolveStoreForHost). Without
	# it, anyone pointing a domain at this IP could make us request certs
	# on their behalf.
	on_demand_tls {
		ask http://app:3000/api/internal/domain-check
	}
}

# Platform apex + storefront subdomains.
#
# Real wildcard TLS for *.{$PLATFORM_ROOT_DOMAIN} in one cert needs a
# DNS-01 challenge: rebuild Caddy with a DNS-provider plugin via xcaddy
# (e.g. Cloudflare) and add:
#     tls { dns cloudflare {env.CLOUDFLARE_API_TOKEN} }
# Until then each storefront subdomain that's actually visited gets its
# own cert on demand, gated by the ask endpoint above.
{$PLATFORM_ROOT_DOMAIN}, *.{$PLATFORM_ROOT_DOMAIN} {
	reverse_proxy app:3000
}

# Merchant custom domains — cert issued on the first HTTPS request, gated
# by the ask endpoint.
https:// {
	tls {
		on_demand
	}
	reverse_proxy app:3000
}

# Plain HTTP: ACME HTTP-01 challenges are served automatically; everything
# else redirects to HTTPS.
:80 {
	redir https://{host}{uri} permanent
}
